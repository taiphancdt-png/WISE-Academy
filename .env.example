# Email delivery for website forms (/api/lead). Set these in the hosting provider's environment settings.
# Google Workspace example: smtp.gmail.com, port 465, user = a wisedemy.com.vn mailbox, pass = an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=website@wisedemy.com.vn
SMTP_PASS=
SMTP_FROM="WISE Academy Website <website@wisedemy.com.vn>"
LEAD_RECIPIENTS=thuynt@wisedemy.com.vn,taipt@wisedemy.com.vn

# Certificate verification (/xac-thuc-chung-chi): read from a Google Sheet with a service account.
# Share the sheet and the Drive folder of certificate images with the service account e-mail (Viewer).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CERT_SHEET_ID=
CERT_SHEET_RANGE=Certificates!A:H
